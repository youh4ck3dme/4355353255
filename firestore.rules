/**
 * @fileoverview Firestore Security Rules for the VI&MO application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data (like checklists),
 * allows public read access for blog posts, and secures contact form submissions to be read-only by admins.
 * Administrative privileges are granted based on document existence in the `/roles_admin` collection.
 *
 * Data Structure:
 * - /blogPosts/{postId}: Stores blog articles. Publicly readable, writeable only by admins.
 * - /checklists/{userId}: Stores a user's personal checklist state. Only accessible by the owner.
 * - /contact_submissions/{submissionId}: Stores submissions from the contact form. Writeable by anyone, readable only by admins.
 * - /users/{userId}: Stores basic user profiles; access is restricted to the user themselves.
 * - /roles_admin/{userId}: Indicates admin status; existence of a document grants admin privileges.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in. Allows anonymous users.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document based on the userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user exists and is the owner of the document based on the userId.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin by verifying the existence of a document in the /roles_admin/{userId} collection.
     */
     function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
     }

    /**
     * @description Rules for the /users/{userId} collection.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }
    
    /**
     * @description Rules for the /blogPosts/{postId} collection.
     * @principle Public read access for published posts, write access for admins only.
     */
    match /blogPosts/{postId} {
        // Anyone can read a post if it's published. Admins can read any post.
        allow get: if resource.data.status == 'published' || isAdmin();
        // Anyone can list (query) published posts.
        allow list: if isAdmin() || (request.query.resource.data.status == 'published');
        // Only admins can create, update, or delete posts.
        allow write: if isAdmin();
    }

    /**
     * @description Rules for the /checklists/{userId} collection.
     * @principle A user can only access their own checklist.
     */
    match /checklists/{userId} {
        // A user can only get, create, update, or delete their own checklist document.
        allow read, write: if isOwner(userId);
    }
    
    /**
     * @description Rules for the /contact_submissions/{submissionId} collection.
     * @principle Anyone can create (submit the form), but only admins can read.
     */
    match /contact_submissions/{submissionId} {
        allow create: if true; // Anyone can submit the form
        allow read, update, delete: if isAdmin(); // Only admins can manage submissions
    }


    /**
     * @description Rules for the /roles_admin/{userId} collection.
     * @principle Restricts admin role creation and deletion to existing admins and the user themselves.
     */
     match /roles_admin/{userId} {
        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin() || isOwner(userId);
     }
  }
}
