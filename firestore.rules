rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check if a user document exists in the roles_admin collection with the user's UID.
      // This is a secure way to assign admin roles.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /blogPosts/{postId} {
      // Admins can create, update, and delete any post.
      allow write: if isAdmin();
      
      // Admins can also read any post, regardless of status.
      allow get: if isAdmin();

      // PUBLIC ACCESS RULES:
      // Allow the public to GET a single document if it's published.
      allow get: if resource.data.status == 'published';

      // Allow the public to LIST documents only when querying for published posts.
      allow list: if request.query.where.size() > 0 && request.query.where[0][0] == 'status' && request.query.where[0][2] == 'published';
    }
    
    match /checklists/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /contact_submissions/{submissionId} {
      // Anyone can create a contact submission.
      allow create: if true;
      // Only admins can read, list, or delete submissions.
      allow read, list, delete: if isAdmin();
    }

    // Admin role management. Only other admins can manage roles.
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow read, write: if isAdmin();
    }
  }
}
