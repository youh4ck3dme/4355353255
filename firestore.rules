/**
 * @file Firebase Security Rules for Firestore.
 * @description This ruleset enforces a strict user-ownership model for checklist data.
 *
 * Data Structure:
 * All checklist data is nested under `/checklists/{userId}`, where `{userId}` corresponds to the Firebase Auth UID. Each user has a single document at this path containing their checklist data.
 *
 * Key Security Decisions:
 * - Users can only access their own checklist data. No cross-user access is permitted.
 * - Listing all checklists is disallowed for security. Only `get` is allowed.
 * - Data schema validation is relaxed in this prototyping phase to allow for rapid iteration, but ownership of the data is strictly enforced.
 *
 * Denormalization for Authorization:
 * - The `userId` is included both in the document path (`/checklists/{userId}`) and as a field within the document itself.  The security rules validate that these two IDs match, ensuring that the user ID is not spoofed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure access to checklist data for individual users.
     * @path /checklists/{userId}
     * @allow (create) Signed-in user creates their own checklist with matching userId.
     *   - request.auth.uid: "user_abc"
     *   - request.resource.data: { userId: "user_abc", categories: ["A", "B"], lastUpdated: "2024-01-01T00:00:00Z" }
     * @allow (get) Signed-in user retrieves their own checklist.
     *   - request.auth.uid: "user_abc"
     * @allow (update) Signed-in user updates their own checklist.
     *   - request.auth.uid: "user_abc"
     *   - request.resource.data: { userId: "user_abc", categories: ["A", "B", "C"], lastUpdated: "2024-01-02T00:00:00Z" }
     * @allow (delete) Signed-in user deletes their own checklist.
     *   - request.auth.uid: "user_abc"
     * @deny (create) Signed-in user attempts to create a checklist for another user.
     *   - request.auth.uid: "user_abc"
     *   - request.resource.data: { userId: "user_def", categories: ["A", "B"], lastUpdated: "2024-01-01T00:00:00Z" }
     * @deny (get) Signed-in user attempts to retrieve another user's checklist.
     *   - request.auth.uid: "user_abc"
     * @deny (update) Signed-in user attempts to update another user's checklist.
     *   - request.auth.uid: "user_abc"
     *   - request.resource.data: { userId: "user_def", categories: ["A", "B", "C"], lastUpdated: "2024-01-02T00:00:00Z" }
     * @deny (delete) Signed-in user attempts to delete another user's checklist.
     *   - request.auth.uid: "user_abc"
     * @principle Enforces document ownership for all operations.
     */
    match /checklists/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the document, and the document exists.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow a user to create their own checklist if the userId matches their auth UID
      allow create: if isOwner(userId) && request.resource.data.userId == userId;

      // Allow a user to get their own checklist
      allow get: if isSignedIn() && isOwner(userId);

      // Disallow listing all checklists.
      allow list: if false;

      // Allow a user to update their own checklist if they are the owner and the document exists.
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;

      // Allow a user to delete their own checklist if they are the owner and the document exists.
      allow delete: if isExistingOwner(userId);
    }
  }
}