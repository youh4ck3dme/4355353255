rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check if a user document exists in the roles_admin collection with the user's UID.
      // This is a secure way to assign admin roles.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /blogPosts/{postId} {
      // Admins can read, write, and list all posts regardless of status.
      allow read, write: if isAdmin();

      // Public users can only read/list posts that are explicitly filtered as 'published'.
      allow read, list: if request.query.where.size() > 0 && request.query.where[0][0] == 'status' && request.query.where[0][2] == 'published';
    }
    
    match /checklists/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /contact_submissions/{submissionId} {
      // Anyone can create a contact submission.
      allow create: if true;
      // Only admins can read, list, or delete submissions.
      allow read, list, delete: if isAdmin();
    }

    // Admin role management. Only other admins can manage roles.
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow read, write: if isAdmin();
    }
  }
}
