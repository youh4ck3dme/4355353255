
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if a document for the user's UID exists in the roles_admin collection.
      // This is a secure way to check for admin privileges.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // BLOG POSTS: Public can read published posts, admins can write anything.
    match /blogPosts/{postId} {
      // Anyone can read a single document if it's published.
      allow get: if resource.data.status == 'published';

      // Anyone can list documents, but the query MUST include `where('status', '==', 'published')`
      // This rule is defensively written; the client query is the source of truth.
      allow list: if request.query.filters.size() == 1 &&
                   request.query.filters[0].field.stringValue == 'status' &&
                   request.query.filters[0].op.stringValue == '==' &&
                   request.query.filters[0].value.stringValue == 'published';

      // Admins can write (create, update, delete) any post.
      allow write: if isAdmin();

      // Admins can read draft posts directly.
      allow get: if isAdmin();
      
      // Admins can list all posts (including drafts)
      allow list: if isAdmin();
    }

    // USER CHECKLISTS: Only the owner can read or write their own checklist.
    match /checklists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // CONTACT FORM SUBMISSIONS: Anyone can create, but no one can read/update from the client.
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false; // Data should only be read by a backend/admin console.
    }

    // USER PROFILES: Only the owner can manage their profile.
    match /users/{userId} {
       allow read, write: if isOwner(userId);
    }
    
    // ADMIN ROLES: Only other admins can see who is an admin. No client-side writes.
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow write: if false; // Should be managed from the server or console.
    }
  }
}
