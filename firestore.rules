rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check if a user document exists in the roles_admin collection with the user's UID.
      // This is a secure way to assign admin roles.
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Public users can only read/list published posts.
    // Admins can write (create, update, delete).
    match /blogPosts/{postId} {
      // Allow public read access only to documents where status is 'published'
      allow get: if resource.data.status == 'published';
      // Allow public list access only for queries that filter by status == 'published'
      allow list: if request.query.get('where')[0][2] == 'published';
      
      // Admins can read all posts regardless of status and can write.
      allow read, write: if isAdmin();
    }
    
    match /checklists/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /contact_submissions/{submissionId} {
      // Anyone can create a contact submission.
      allow create: if true;
      // Only admins can read, list, or delete submissions.
      allow read, list, delete: if isAdmin();
    }

    // Admin role management. Only other admins can manage roles.
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow read, write: if isAdmin();
    }
  }
}
