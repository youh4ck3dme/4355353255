
# ===================================================
# Firebase Client Configuration
# Tieto hodnoty sú verejné a používajú sa na strane klienta.
# Nájdete ich v nastaveniach vášho Firebase projektu > Project settings > General.
# ===================================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy...your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:your-sender-id:web:your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-your-measurement-id"

# ===================================================
# Firebase Admin SDK Configuration (Server-Side)
# Tieto hodnoty sú citlivé a používajú sa len na strane servera.
# Získate ich z Firebase projektu > Project settings > Service accounts > Generate new private key.
# PRIVATE_KEY musí byť vložený ako jeden riadok, nahraďte znaky nového riadku za '\n'.
# ===================================================
PROJECT_ID="your-project-id"
CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...private-key-content...\n-----END PRIVATE KEY-----\n"

# ===================================================
# Application Specific Configuration
# Heslo pre prístup do /admin sekcie.
# ===================================================
NEXT_PUBLIC_ADMIN_PASSWORD="your-secure-admin-password"
